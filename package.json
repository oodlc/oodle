{
  "name": "oodle",
  "version": "0.4.0",
  "description": "Oodle, the CLI for OODLC (Open Outcome Delivery Lifecycle). CI that protects declared outcomes and watches observed behavior.",
  "homepage": "https://github.com/oodlc/oodle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oodlc/oodle.git"
  },
  "bugs": {
    "url": "https://github.com/oodlc/oodle/issues"
  },
  "type": "module",
  "bin": {
    "oodle": "./bin/oodle.js"
  },
  "exports": {
    "./adapter": "./src/adapter.ts",
    "./contract": "./src/contract.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "spec",
    "docs/cli.md",
    "docs/agents.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "oodle": "node bin/oodle.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node bin/oodle.js run examples/checkout"
  },
  "keywords": [
    "oodlc",
    "oodle",
    "outcomes",
    "ci",
    "testing",
    "agents",
    "behavior",
    "verification"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.6.4",
    "express": "^5.2.1",
    "hono": "^4.13.13",
    "koa": "^3.2.1",
    "typescript": "^7.0.2"
  }
}
