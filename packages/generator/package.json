{
  "name": "@oodle/generator",
  "version": "0.0.0",
  "private": true,
  "description": "Drives Claude Code headless to build an app from the spec",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@oodle/compile": "workspace:*",
    "@oodle/runtime": "workspace:*",
    "@oodle/spec": "workspace:*",
    "@oodle/template": "workspace:*",
    "@oodle/verify": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
