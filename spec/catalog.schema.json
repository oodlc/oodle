{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oodlc.com/schema/v0/catalog.json",
  "title": "OODLC catalog file (v0)",
  "description": "One YAML file in a catalog directory. Any file may hold any of the five sections.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": { "const": 0 },
    "intents": { "type": "array", "items": { "$ref": "#/definitions/intent" } },
    "outcomes": { "type": "array", "items": { "$ref": "#/definitions/outcome" } },
    "behaviors": { "type": "array", "items": { "$ref": "#/definitions/behavior" } },
    "conditions": { "type": "array", "items": { "$ref": "#/definitions/condition" } },
    "constraints": { "type": "array", "items": { "$ref": "#/definitions/constraint" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 128 },
    "status": {
      "description": "Drafted, not yet approved by a human. A proposed entry runs and is reported, but never blocks. Approving it means deleting this field. See docs/decisions/0006.",
      "const": "proposed"
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "statement": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" }
      }
    },
    "stub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": {},
        "error": { "type": "string" },
        "latency_ms": { "type": "number", "minimum": 0 }
      }
    },
    "given": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "body": {},
        "headers": {
          "description": "Request headers. A null value drops that header; null sends no headers at all.",
          "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": { "type": ["string", "null"] } }]
        },
        "state": { "type": "object" },
        "db": {
          "description": "Rows each table of the simulated database starts with, by table name (schema.table outside public). Listing a table replaces the rows defaults or the schema gave it. Needs database in oodlc/config.yaml.",
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "object" } }
        },
        "stubs": { "type": "object", "additionalProperties": { "$ref": "#/definitions/stub" } },
        "repeat": {
          "description": "Send the same request this many times against the same state (2 is a replay). The last response is observed; effects accumulate.",
          "type": "integer", "minimum": 1, "maximum": 10
        },
        "fuzz": {
          "description": "Rewrite the request body before sending it: injection (every string becomes an attack payload), oversize (adds a 1MB field), extra-fields (adds privileged fields such as role: admin to every object).",
          "enum": ["injection", "oversize", "extra-fields"]
        }
      }
    },
    "boundary": { "enum": ["customer", "external", "data", "obligation", "internal"] },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["http"],
      "properties": {
        "http": { "type": "string", "pattern": "^(GET|POST|PUT|PATCH|DELETE) /\\S*$" },
        "given": { "$ref": "#/definitions/given" }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "status": {
          "description": "An exact status, or a matcher such as { gte: 400, lte: 499 }",
          "oneOf": [{ "type": "integer", "minimum": 100, "maximum": 599 }, { "type": "object", "minProperties": 1 }]
        },
        "body": { "type": "object" },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "count"],
            "properties": {
              "kind": { "type": "string" },
              "match": { "type": "object" },
              "count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "latency_ms_max": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "outcome": {
      "description": "Declared, human-approved, durable by definition.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "boundary", "trigger", "expect"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "intent": { "$ref": "#/definitions/id" },
        "statement": { "type": "string", "minLength": 1 },
        "boundary": { "$ref": "#/definitions/boundary" },
        "trigger": { "$ref": "#/definitions/trigger" },
        "conditions": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
        "expect": { "$ref": "#/definitions/expect" },
        "when": {
          "description": "Expectations per condition. Each key is a condition from `conditions`; each field it names replaces the same field of `expect` under that condition. See docs/decisions/0004.",
          "type": "object", "additionalProperties": { "$ref": "#/definitions/expect" }
        },
        "constraints": {
          "description": "Traceability only: the constraints this outcome depends on. Every constraint is checked on every run regardless. See docs/decisions/0002.",
          "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true
        },
        "status": { "$ref": "#/definitions/status" }
      }
    },
    "behavior": {
      "description": "Observed by the runner, not durable by default. Drift is reported, never blocking.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "boundary", "trigger"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "statement": { "type": "string", "minLength": 1 },
        "boundary": { "$ref": "#/definitions/boundary" },
        "trigger": { "$ref": "#/definitions/trigger" },
        "conditions": { "type": "array", "items": { "$ref": "#/definitions/id" }, "uniqueItems": true },
        "observed": { "$ref": "#/definitions/expect" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "given"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "statement": { "type": "string" },
        "given": { "$ref": "#/definitions/given" }
      }
    },
    "constraint": {
      "description": "Human-declared invariant. Checked on every run (outcomes, behaviors, probes of unknown routes); a violation always blocks, and so does changing or removing one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "check"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "statement": { "type": "string", "minLength": 1 },
        "check": { "description": "JS expression over effects, state, response, request and db (each table's rows after the run, with the simulated database); must be true", "type": "string", "minLength": 1 },
        "status": { "$ref": "#/definitions/status" }
      }
    }
  }
}
