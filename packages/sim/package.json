{
  "name": "@oodle/sim",
  "version": "0.0.0",
  "private": true,
  "description": "Runs builds in a sealed Miniflare simulation and records observations",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oodle/runtime": "workspace:*",
    "@oodle/spec": "workspace:*",
    "esbuild": "^0.28.2",
    "hono": "4.13.13",
    "miniflare": "4.20260730.0",
    "parse5": "^8.0.1"
  }
}
