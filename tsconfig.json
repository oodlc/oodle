{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "paths": {
      "@oodlc/oodle/adapter": [
        "./src/adapter.ts"
      ],
      "@oodlc/oodle/contract": [
        "./src/contract.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples"
  ]
}
