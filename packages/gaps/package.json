{
  "name": "@oodle/gaps",
  "version": "0.0.0",
  "private": true,
  "description": "Writes questions for gaps, classifies their tier and stores them",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oodle/compile": "workspace:*",
    "@oodle/diff": "workspace:*",
    "@oodle/sim": "workspace:*",
    "@oodle/spec": "workspace:*",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
