{
  "name": "@oodlc/oodle",
  "version": "0.7.0",
  "description": "Oodle, the CLI for OODLC (Open Outcome Delivery Lifecycle). CI that protects declared outcomes and watches observed behavior.",
  "homepage": "https://github.com/oodlc/oodle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oodlc/oodle.git"
  },
  "bugs": {
    "url": "https://github.com/oodlc/oodle/issues"
  },
  "type": "module",
  "bin": {
    "oodle": "bin/oodle.js"
  },
  "exports": {
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "spec",
    "docs/cli.md",
    "docs/agents.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "oodle": "node bin/oodle.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node bin/oodle.js run examples/checkout",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "oodlc",
    "oodle",
    "outcomes",
    "ci",
    "testing",
    "agents",
    "behavior",
    "verification"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "axios": "^1.20.0",
    "express": "^5.2.1",
    "hono": "^4.13.13",
    "koa": "^3.2.1",
    "next": "^16.3.8",
    "next15": "npm:next@^15.5.27",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
