{
  "name": "@oodle/compile",
  "version": "0.0.0",
  "private": true,
  "description": "Compiles journeys, exploration and constraints into structured checks",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "compile:dogwalk": "node scripts/compile-dogwalk.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@oodle/sim": "workspace:*",
    "@oodle/spec": "workspace:*",
    "zod": "4.6.7"
  }
}
